PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-seguro

# Ya no se usa Disk de Render. La persistencia corre por Litestream (bingo.db)
# y Cloudflare R2 (logo del sitio), asi que esto puede quedar vacio/sin definir.
DATA_DIR=

# Cloudflare R2 (S3-compatible). Mismo bucket/credenciales para:
#  - Litestream: respalda/restaura bingo.db (ver litestream.yml)
#  - r2.js: guarda el logo del sitio subido desde Configuracion
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
